{
  "$defs": {
    "ArchiveCadence": {
      "enum": [
        "daily",
        "monthly"
      ],
      "title": "ArchiveCadence",
      "type": "string"
    },
    "ArchiveDataset": {
      "enum": [
        "klines",
        "mark_price_klines",
        "funding_rate",
        "agg_trades"
      ],
      "title": "ArchiveDataset",
      "type": "string"
    },
    "BinanceArchiveSource": {
      "additionalProperties": false,
      "properties": {
        "cadence": {
          "$ref": "#/$defs/ArchiveCadence"
        },
        "dataset": {
          "$ref": "#/$defs/ArchiveDataset"
        },
        "interval": {
          "anyOf": [
            {
              "const": "1m",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "kind": {
          "const": "binance_archive",
          "title": "Kind",
          "type": "string"
        },
        "period_start": {
          "format": "date-time",
          "title": "Period Start",
          "type": "string"
        },
        "resolved_url": {
          "readOnly": true,
          "title": "Resolved Url",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{3,32}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "cadence",
        "dataset",
        "symbol",
        "period_start",
        "resolved_url"
      ],
      "title": "BinanceArchiveSource",
      "type": "object"
    },
    "BinanceRestEndpoint": {
      "enum": [
        "exchange_info",
        "klines",
        "mark_price_klines",
        "funding_rate",
        "agg_trades"
      ],
      "title": "BinanceRestEndpoint",
      "type": "string"
    },
    "BinanceRestSource": {
      "additionalProperties": false,
      "properties": {
        "end_time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        },
        "endpoint": {
          "$ref": "#/$defs/BinanceRestEndpoint"
        },
        "from_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Id"
        },
        "interval": {
          "anyOf": [
            {
              "const": "1m",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "kind": {
          "const": "binance_rest",
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "resolved_url": {
          "readOnly": true,
          "title": "Resolved Url",
          "type": "string"
        },
        "start_time": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{3,32}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "endpoint",
        "symbol",
        "limit",
        "resolved_url"
      ],
      "title": "BinanceRestSource",
      "type": "object"
    },
    "BinanceStream": {
      "enum": [
        "kline_1m",
        "mark_price",
        "agg_trade",
        "best_bid_ask"
      ],
      "title": "BinanceStream",
      "type": "string"
    },
    "BinanceWebSocketSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "binance_websocket",
          "title": "Kind",
          "type": "string"
        },
        "resolved_url": {
          "readOnly": true,
          "title": "Resolved Url",
          "type": "string"
        },
        "stream": {
          "$ref": "#/$defs/BinanceStream"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{3,32}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "stream",
        "symbol",
        "resolved_url"
      ],
      "title": "BinanceWebSocketSource",
      "type": "object"
    },
    "DataType": {
      "enum": [
        "kline_1m",
        "mark_price",
        "funding",
        "agg_trade",
        "best_bid_ask"
      ],
      "title": "DataType",
      "type": "string"
    },
    "DeduplicationMethod": {
      "enum": [
        "reject_duplicates",
        "keep_first",
        "keep_last"
      ],
      "title": "DeduplicationMethod",
      "type": "string"
    },
    "InstrumentRef": {
      "additionalProperties": false,
      "properties": {
        "market": {
          "const": "USD_M_PERPETUAL",
          "title": "Market",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]+$",
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "const": "BINANCE",
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "venue",
        "market",
        "symbol"
      ],
      "title": "InstrumentRef",
      "type": "object"
    },
    "MissingInterval": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "MissingInterval",
      "type": "object"
    },
    "RepairRecord": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/RepairResult"
        },
        "source": {
          "$ref": "#/$defs/RepairSource"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "started_at",
        "completed_at",
        "source",
        "result"
      ],
      "title": "RepairRecord",
      "type": "object"
    },
    "RepairResult": {
      "enum": [
        "repaired",
        "partial",
        "failed",
        "source_pending"
      ],
      "title": "RepairResult",
      "type": "string"
    },
    "RepairSource": {
      "enum": [
        "binance_archive",
        "binance_rest"
      ],
      "title": "RepairSource",
      "type": "string"
    },
    "ValidationState": {
      "enum": [
        "pending",
        "validated",
        "rejected"
      ],
      "title": "ValidationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data_type": {
      "$ref": "#/$defs/DataType"
    },
    "deduplication_method": {
      "$ref": "#/$defs/DeduplicationMethod"
    },
    "duplicates_removed": {
      "minimum": 0,
      "title": "Duplicates Removed",
      "type": "integer"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "instrument": {
      "$ref": "#/$defs/InstrumentRef"
    },
    "manifest_id": {
      "format": "uuid",
      "title": "Manifest Id",
      "type": "string"
    },
    "missing_intervals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MissingInterval"
      },
      "title": "Missing Intervals",
      "type": "array"
    },
    "normalization_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Normalization Version",
      "type": "string"
    },
    "normalized_checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalized Checksum",
      "type": "string"
    },
    "normalized_path": {
      "minLength": 1,
      "title": "Normalized Path",
      "type": "string"
    },
    "primary_key_fields": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Primary Key Fields",
      "type": "array"
    },
    "raw_path": {
      "minLength": 1,
      "title": "Raw Path",
      "type": "string"
    },
    "repair_history": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RepairRecord"
      },
      "title": "Repair History",
      "type": "array"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "row_count": {
      "exclusiveMinimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "discriminator": {
        "mapping": {
          "binance_archive": "#/$defs/BinanceArchiveSource",
          "binance_rest": "#/$defs/BinanceRestSource",
          "binance_websocket": "#/$defs/BinanceWebSocketSource"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BinanceArchiveSource"
        },
        {
          "$ref": "#/$defs/BinanceRestSource"
        },
        {
          "$ref": "#/$defs/BinanceWebSocketSource"
        }
      ],
      "title": "Source"
    },
    "source_checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Checksum",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "validation_state": {
      "$ref": "#/$defs/ValidationState"
    }
  },
  "required": [
    "manifest_id",
    "instrument",
    "data_type",
    "start",
    "end",
    "retrieved_at",
    "schema_version",
    "normalization_version",
    "source",
    "raw_path",
    "normalized_path",
    "source_checksum",
    "normalized_checksum",
    "row_count",
    "validation_state",
    "primary_key_fields",
    "deduplication_method",
    "duplicates_removed"
  ],
  "title": "DataManifest",
  "type": "object"
}
