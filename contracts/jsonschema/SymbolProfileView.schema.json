{
  "$defs": {
    "ProfileMetricView": {
      "additionalProperties": false,
      "properties": {
        "coverage_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage Fraction",
          "type": "number"
        },
        "sample_count": {
          "minimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "sample_count",
        "coverage_fraction"
      ],
      "title": "ProfileMetricView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calculated_at": {
      "format": "date-time",
      "title": "Calculated At",
      "type": "string"
    },
    "coverage_end": {
      "format": "date-time",
      "title": "Coverage End",
      "type": "string"
    },
    "coverage_start": {
      "format": "date-time",
      "title": "Coverage Start",
      "type": "string"
    },
    "funding_rate_mean": {
      "$ref": "#/$defs/ProfileMetricView"
    },
    "jump_frequency": {
      "$ref": "#/$defs/ProfileMetricView"
    },
    "median_hourly_volume": {
      "$ref": "#/$defs/ProfileMetricView"
    },
    "median_spread_bps": {
      "$ref": "#/$defs/ProfileMetricView"
    },
    "realized_volatility": {
      "$ref": "#/$defs/ProfileMetricView"
    },
    "symbol": {
      "pattern": "^[A-Z0-9]{3,32}$",
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "calculated_at",
    "coverage_start",
    "coverage_end",
    "realized_volatility",
    "jump_frequency",
    "median_spread_bps",
    "median_hourly_volume",
    "funding_rate_mean"
  ],
  "title": "SymbolProfileView",
  "type": "object"
}
