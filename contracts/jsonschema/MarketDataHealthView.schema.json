{
  "$defs": {
    "SourceMode": {
      "enum": [
        "direct",
        "proxy",
        "degraded"
      ],
      "title": "SourceMode",
      "type": "string"
    },
    "StreamStateView": {
      "additionalProperties": false,
      "properties": {
        "last_event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Event At"
        },
        "status": {
          "$ref": "#/$defs/StreamStatus"
        },
        "stream_name": {
          "minLength": 1,
          "title": "Stream Name",
          "type": "string"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{3,32}$",
          "title": "Symbol",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "stream_name",
        "status",
        "last_event_at",
        "updated_at"
      ],
      "title": "StreamStateView",
      "type": "object"
    },
    "StreamStatus": {
      "enum": [
        "connecting",
        "connected",
        "degraded",
        "disconnected"
      ],
      "title": "StreamStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archive_healthy": {
      "title": "Archive Healthy",
      "type": "boolean"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "rest_healthy": {
      "title": "Rest Healthy",
      "type": "boolean"
    },
    "source_mode": {
      "$ref": "#/$defs/SourceMode"
    },
    "streams": {
      "items": {
        "$ref": "#/$defs/StreamStateView"
      },
      "title": "Streams",
      "type": "array"
    },
    "worker_heartbeat_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Worker Heartbeat At"
    }
  },
  "required": [
    "source_mode",
    "archive_healthy",
    "rest_healthy",
    "worker_heartbeat_at",
    "streams",
    "checked_at"
  ],
  "title": "MarketDataHealthView",
  "type": "object"
}
